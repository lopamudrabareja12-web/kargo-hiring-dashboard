# Supabase: Project Settings -> API. Use the service-role (secret) key. Server-side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini: use a key from a project with BILLING ENABLED (free-tier inputs may be used to train Google's models).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional: thinking token budget per call (0 = off, -1 = automatic). Default 1024.
GEMINI_THINKING_BUDGET=1024

# Resend: leave blank until checkpoint B-2.
RESEND_API_KEY=
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>
# Optional: redirect every send to this address (adds "[TEST] original recipient: ..." to the body).
EMAIL_OVERRIDE_TO=

# Dashboard login password (long and random).
DASHBOARD_PASSWORD=change-me
SCHEDULING_LINK=https://cal.com/your-link
SENDER_NAME=Arjun Mehta, Founder, Kargo
